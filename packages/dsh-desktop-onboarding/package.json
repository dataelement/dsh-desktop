{
  "name": "dsh-desktop-onboarding",
  "version": "0.1.0",
  "description": "DSH Desktop first-run notice: the internal-testing declaration and project intro, with a shortcut to the models settings.",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.1 || ^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.5-rc.1 || ^0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.5-rc.1 || ^0.1.7-rc.1",
    "react": "^18.2.0"
  }
}
