      text: '<p><span style="color:#153C2E;font-size:11.6px;font-family:Arial">Flexible focus</span></p><p></p><p><span style="color:#153C2E;font-size:11.6px;font-family:Arial">Match the setting to the work: quiet concentration, field observation or collaborative making.</span></p><p></p><p><span style="color:#153C2E;font-size:11.6px;font-family:Arial">Show one specific routine.</span></p>'
    sourceLayout: 880ec5486c4966c353fa6346a665c25a27c161acdf52000f0d298f45e067da47
  - elementId: slide-16-node-253-article-1
    elementType: text
    bounds:
