    content:
      fontFamily: Arial
      fontSize: 11.6
      color: '#153C2E'
      align:
        - left
        - top
      wrap: true
      text: <p><span style="color:#153C2E;font-size:11.6px;font-family:Arial">Walking reviews</span></p><p></p><p><span style="color:#153C2E;font-size:11.6px;font-family:Arial">A short walk through the site can reveal details that disappear in a meeting room.</span></p><p></p><p><span style="color:#153C2E;font-size:11.6px;font-family:Arial">Capture decisions when the walk ends.</span></p>
    sourceLayout: 0490b9ed658d3e1981c1bee4b697cbebb2845e4acfb224d6aca0bbab75309e67
  - elementId: slide-16-node-254-article-2
    elementType: text
    bounds:
      - 648
      - 125
      - 132
      - 384
    content:
      fontFamily: Arial
      fontSize: 11.6
      color: '#153C2E'
      align:
        - left
        - top
      wrap: true
      text: <p><span style="color:#153C2E;font-size:11.6px;font-family:Arial">Listen in context</span></p><p></p><p><span style="color:#153C2E;font-size:11.6px;font-family:Arial">Invite feedback where the program is actually used and make it easy to point at a concrete issue.</span></p><p></p><p><span style="color:#153C2E;font-size:11.6px;font-family:Arial">Record the pattern, not every comment.</span></p>
    sourceLayout: b30f50f2ab5ecf1ea4f99cc4c20b60d6f78ac3570be26ed1ae7eb6c475b26965
  - elementId: slide-16-node-255-article-3
    elementType: text
    bounds:
      - 801
      - 125
      - 132
      - 384
    content:
      fontFamily: Arial
      fontSize: 11.6
      color: '#153C2E'
      align:
        - left
        - top
      wrap: true
      text: <p><span style="color:#153C2E;font-size:11.6px;font-family:Arial">Keep the loop open</span></p><p></p><p><span style="color:#153C2E;font-size:11.6px;font-family:Arial">Tell participants what changed because of their input and what still needs evidence.</span></p><p></p><p><span style="color:#153C2E;font-size:11.6px;font-family:Arial">Close the loop with a date.</span></p>
    sourceLayout: 1a11be40575ce7c61b5ead3b051ad05235bb922cd17a5e0ee49570a592b0d770
