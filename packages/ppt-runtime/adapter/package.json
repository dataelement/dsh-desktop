{
  "name": "dsh-ppt-composer",
  "description": "PPT composer for DSH Desktop",
  "version": "0.1.1-rc.2",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dataelement/dsh-desktop.git",
    "directory": "packages/ppt-runtime/adapter"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inline": [
        "dsh-ppt/client-standard"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {},
  "dependencies": {
    "dsh-ppt": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-invariants": "^0.1.5-rc.1"
  },
  "keywords": [
    "dsh-plugin",
    "pptd",
    "pptx",
    "presentation"
  ]
}
