{
  "name": "dsh-desktop",
  "version": "0.1.0",
  "description": "A cross-platform desktop shell for DeepSeek Harness.",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "DataElement",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dataelement/dsh-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/dataelement/dsh-desktop/issues"
  },
  "homepage": "https://github.com/dataelement/dsh-desktop#readme",
  "keywords": [
    "deepseek",
    "harness",
    "electron",
    "desktop",
    "agent"
  ],
  "scripts": {
    "postinstall": "patch-package && node scripts/install-brand-assets.mjs && install-electron --no",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:dir": "npm run build && electron-builder --dir",
    "package:mac": "npm run build && electron-builder --mac",
    "package:mac:arm64": "node scripts/verify-target.mjs darwin arm64 && npm run build && electron-builder --mac --arm64",
    "package:mac:x64": "node scripts/verify-target.mjs darwin x64 && npm run build && electron-builder --mac --x64",
    "package:win": "node scripts/verify-target.mjs win32 x64 && npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "patch-package": "^8.0.1",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  },
  "build": {
    "appId": "io.dsh.desktop",
    "productName": "DSH Desktop",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "artifactName": "dsh-desktop-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "dsh-desktop-windows-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "dsh-desktop-windows-${arch}-portable.${ext}"
    }
  }
}
