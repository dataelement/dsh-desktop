    "@types/ws": "^8.18.1",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "patch-package": "^8.0.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10",
    "yaml": "^2.8.3"
  },
  "overrides": {
    "koffi": "3.1.5"
  },
  "build": {
    "appId": "io.dsh.desktop",
    "productName": "DSH Desktop",
    "asar": false,
    "npmRebuild": false,
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "zh-CN",
      "zh_CN",
      "zh-TW",
      "zh_TW"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json",
      "!**/*.map",
      "!**/node_modules/@mistralai/mistralai/src/**"
    ],
    "extraResources": [
      {
        "from": "build/app-icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/harness-node-entry.mjs",
        "to": "harness-node-entry.mjs"
      },
      {
        "from": "build/windows-child-process-hide.mjs",
        "to": "windows-child-process-hide.mjs"
      },
      {
        "from": "build/dsh-desktop.patch.yml",
        "to": "dsh-desktop.patch.yml"
      },
      {
        "from": "build/splash.html",
        "to": "splash.html"
      },
      {
        "from": "build/dsh-loader.gif",
        "to": "dsh-loader.gif"
      },
      {
        "from": "build/dsh-loader-dark.gif",
        "to": "dsh-loader-dark.gif"
      },
      {
        "from": "build/plugin-recovery.html",
        "to": "plugin-recovery.html"
      },
      {
        "from": "build/safe-mode.html",
        "to": "safe-mode.html"
      },
      {
        "from": "build/windows-menu.html",
        "to": "windows-menu.html"
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://dshdesktop.com/updates/latest/"
      }
    ],
    "detectUpdateChannel": false,
    "artifactName": "dsh-desktop-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "format": "UDBZ"
    },
    "win": {
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "dsh-desktop-windows-${arch}-setup.${ext}",
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
