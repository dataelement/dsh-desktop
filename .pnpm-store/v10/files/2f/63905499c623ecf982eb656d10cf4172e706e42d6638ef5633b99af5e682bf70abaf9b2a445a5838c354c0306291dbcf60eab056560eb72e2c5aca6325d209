    "@deepseek-ai/dsh-session-query-sqlite": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session-title": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-spill": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-spill-local": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.5-rc.2",
