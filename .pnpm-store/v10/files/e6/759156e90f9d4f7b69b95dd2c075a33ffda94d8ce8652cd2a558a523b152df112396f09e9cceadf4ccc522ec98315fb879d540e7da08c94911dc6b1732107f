{
  "name": "obug",
  "type": "module",
  "version": "2.2.1",
  "description": "A lightweight JavaScript debugging utility, forked from debug, featuring TypeScript and ESM support.",
  "author": "Kevin Deng <sxzz@sxzz.moe>",
  "license": "MIT",
  "funding": [
    "https://github.com/sponsors/sxzz",
    "https://opencollective.com/debug"
  ],
  "homepage": "https://github.com/sxzz/obug#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxzz/obug.git"
  },
  "bugs": {
    "url": "https://github.com/sxzz/obug/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "workerd": "./dist/plain.js",
      "edge-light": "./dist/plain.js",
      "fastly": "./dist/plain.js",
      "browser": "./dist/browser.js",
      "react-native": "./dist/plain.js",
      "node": "./dist/ansi.js",
      "default": "./dist/browser.js"
    },
    "./ansi": "./dist/ansi.js",
    "./browser": "./dist/browser.js",
    "./plain": "./dist/plain.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/ansi.js",
  "module": "./dist/ansi.js",
  "unpkg": "./dist/browser.min.js",
  "jsdelivr": "./dist/browser.min.js",
  "react-native": "./dist/plain.js",
  "types": "./dist/browser.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=12.20.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@sxzz/eslint-config": "^8.6.0",
    "@sxzz/prettier-config": "^2.3.2",
    "@types/debug": "^4.1.13",
    "@types/node": "^26.5.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "bumpp": "^12.3.0",
    "debug": "^4.4.3",
    "eslint": "^10.10.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "prettier": "@sxzz/prettier-config",
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix",
    "build": "tsdown",
    "size": "node scripts/bundle-size.ts",
    "dev": "tsdown --watch",
    "test": "vitest",
    "test:coverage": "vitest --project node --coverage",
    "play": "vite playground",
    "typecheck": "tsgo --noEmit",
    "format": "prettier --cache --write .",
    "release": "bumpp"
  }
}